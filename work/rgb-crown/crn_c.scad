// CRN-C proposal (Brian 2026-10-30): reprinted Lab Rax top front beam + bench-built panel cassette.
// Beam: original ends (|x| >= END) kept exactly from the creator mesh; the middle is the solid end-block
// profile (section at x = 116, same outside shape) extruded, with a cable slot, a bottom hook bar and two
// side lugs. Cassette: tray + P2 64x32 panel + bezel ring, wired on the bench, then hooked in at the
// bottom and held by 2 x M3 side screws through the beam lugs.
// Beam-local coordinates (-Y = rack front, Z up). Slope frame: X along the beam, S up the face, N out.
// PROPOSAL ONLY: panel numbers are placeholders until Brian names the panel. Fit, strength UNKNOWN.

include <crn_c_profile.scad>   // PROFILE = [[y, z], ...] (generated by build_crn_c.py)

part = "beam";          // beam | tray | bezel | panel | screws
beam_stl = "beam_orig.stl";

FC = 21.85; ZB = -7.575; END = 111; W = 112;
GY0 = 6.58; GZ0 = 22.72; GZ1 = 26.22;   // roof seat groove
PW = 128; PH = 64; PD = 15; C = 0.4;    // panel nominal; depth UNKNOWN (placeholder)
T = 3; WALL = 3; BZ = 2; LIP = 0.6; G = 0.3;   // G = cassette back gap above the face
S0 = 9;                                 // cassette bottom edge, up the face
IW = PW + 2*C; IH = PH + 2*C; OW = IW + 2*WALL; OH = IH + 2*WALL;
TN = T + PD + C;
EAR_S = [S0 + 12, S0 + OH - 12];        // bezel screw ears
// bottom hook: cassette tongue under a bar on the beam
TG = [4, 2.4];                          // tongue length down the slope, thickness
HB = [S0 - TG[0] - 2.5, 3.4, 6];        // hook bar: start S, slot height N, total N
// side screws: lugs on the beam, bosses on the cassette
LUG_S = 38; LUG = [7, 9, 10];           // lug X width, S length, N height
BOSS = 8;                               // cassette side boss X width (holds the M3 insert)
CAB = [70, 16];                         // cable slot through the beam plate (w, S length)

r = 1 / sqrt(2);
O = [0, ZB - FC, ZB];
module frame() multmatrix([[1, 0, 0, O[0]], [0, r, -r, O[1]], [0, r, r, O[2]], [0, 0, 0, 1]]) children();

module tray() {
    difference() {
        union() {
            translate([-OW/2, S0, G]) cube([OW, OH, TN]);
            translate([-OW/2 + 6, S0 - TG[0], G]) cube([OW - 12, TG[0] + 1, TG[1]]);          // bottom tongue
            for (sx = [-1, 1], s = EAR_S) translate([sx * (OW/2 + 4), s, G]) cylinder(d = 10, h = TN, $fn = 32);
            for (sx = [-1, 1]) translate([sx > 0 ? OW/2 - 1 : -OW/2 - BOSS + 1, LUG_S - LUG[1]/2, G]) cube([BOSS, LUG[1], LUG[2] - G]);
        }
        translate([-IW/2, S0 + WALL, G + T]) cube([IW, IH, TN]);
        translate([-CAB[0]/2, S0 + WALL + 6, G - 1]) cube([CAB[0], CAB[1], T + 2]);             // cables out the back
        for (sx = [-1, 1], s = EAR_S) translate([sx * (OW/2 + 4), s, G + TN - 6]) cylinder(d = 4.0, h = 7, $fn = 24);
        for (sx = [-1, 1]) translate([sx * (OW/2 + BOSS - 1), LUG_S, G + LUG[2]/2]) rotate([0, 90, 0]) cylinder(d = 4.0, h = 12, center = true, $fn = 24);
        translate([0, S0 + OH - 10, G - 0.01]) mirror([1, 0, 0]) linear_extrude(0.6) text("CRN-C", size = 7, halign = "center", valign = "center", font = "Liberation Sans:style=Bold");
    }
}

module bezel() {
    difference() {
        union() {
            translate([-OW/2, S0, G + TN]) cube([OW, OH, BZ]);
            for (sx = [-1, 1], s = EAR_S) translate([sx * (OW/2 + 4), s, G + TN]) cylinder(d = 10, h = BZ, $fn = 32);
        }
        translate([-PW/2 + LIP, S0 + WALL + C + LIP, G + TN - 1]) cube([PW - 2*LIP, PH - 2*LIP, BZ + 2]);
        for (sx = [-1, 1], s = EAR_S) translate([sx * (OW/2 + 4), s, G + TN - 1]) cylinder(d = 3.4, h = BZ + 2, $fn = 24);
        translate([0, S0 + 1.5, G + TN - 0.01]) mirror([1, 0, 0]) linear_extrude(0.5) text("CRN-C-BZ", size = 2, halign = "center", valign = "center", font = "Liberation Sans:style=Bold");
    }
}

module middle() {
    difference() {
        union() {
            rotate([90, 0, 90]) translate([0, 0, -W]) linear_extrude(2 * W) polygon(PROFILE);
            frame() {
                translate([-OW/2 + 6, HB[0], 0]) cube([OW - 12, S0 - HB[0] - 0.4, HB[2]]);          // hook bar
                for (sx = [-1, 1]) translate([sx > 0 ? OW/2 + BOSS - 1 + 0.4 : -OW/2 - BOSS + 1 - 0.4 - LUG[0], LUG_S - LUG[1]/2, 0]) cube([LUG[0], LUG[1], LUG[2]]);
            }
        }
        frame() {
            translate([-OW/2 + 5.6, HB[0] + 2.5 - 0.4, -0.01]) cube([OW - 11.2, TG[0] + 2, G + TG[1] + 0.4]);  // tongue slot under the bar
            translate([-CAB[0]/2, S0 + WALL + 6, -20]) cube([CAB[0], CAB[1], 21]);                       // cable slot through the plate
            for (sx = [-1, 1]) translate([sx * (OW/2 + BOSS + LUG[0]), LUG_S, LUG[2]/2]) rotate([0, 90, 0]) cylinder(d = 3.4, h = 2 * LUG[0] + 4, center = true, $fn = 24);
            translate([0, 44, -0.6]) linear_extrude(0.7) text("CRN-C-BM", size = 5, halign = "center", valign = "center", font = "Liberation Sans:style=Bold");  // ID under the cassette
        }
        translate([-W - 1, GY0, GZ0]) cube([2*W + 2, 3, GZ1 - GZ0]);                                      // roof seat groove
    }
}

module ends() {
    intersection() {
        import(beam_stl, convexity = 10);
        union() for (s = [-1, 1]) translate([s > 0 ? END : -150, -40, -40]) cube([150 - END, 80, 80]);
    }
}

if (part == "beam") union() { ends(); middle(); }
if (part == "tray") frame() tray();
if (part == "bezel") frame() bezel();
if (part == "panel") frame() translate([-PW/2, S0 + WALL + C, G + T]) cube([PW, PH, PD]);
if (part == "screws") frame() for (sx = [-1, 1]) translate([sx * (OW/2 + BOSS + LUG[0] - 6 + 0.4), LUG_S, LUG[2]/2]) rotate([0, 90, 0]) cylinder(d = 3, h = 12, center = true, $fn = 16);
