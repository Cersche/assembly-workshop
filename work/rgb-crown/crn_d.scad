// CRN-D concept (Brian 2026-10-30): wide RGB display built into a reprinted Lab Rax top front beam.
// The display stays inside the beam's sloped face (no crown above the beam). Beam: original ends
// (|x| >= END) kept exactly from the creator mesh; middle = the stock end-block section (x = 116)
// extruded, plus a visor pocket on the face and a cable slot through the plate. Cassette: a carrier
// plate the panels are screwed to and wired on the bench; it drops into the visor from the front and
// is held by 4 x M3 into heat-set inserts in the beam face.
// Beam-local coordinates (-Y = rack front, Z up). Slope frame: X along the beam, S up the face, N out.
// CONCEPT ONLY: the panel is a placeholder (2 x 64x32 at 1.25 mm pitch = 160 x 40, depth 12): exact
// panel, availability, mounting posts and connectors UNKNOWN. Fit, strength UNKNOWN. Not printed.

include <crn_c_profile.scad>   // PROFILE = stock section at x = 116 (generated by build_crn_c.py)

part = "beam";          // beam | carrier | panel | screws
beam_stl = "beam_orig.stl";

FC = 21.85; ZB = -7.575; END = 111; W = 112;
GY0 = 6.58; GZ0 = 22.72; GZ1 = 26.22;   // roof seat groove
FACE = [2.9, 49.4];     // stock face, S range (front edge .. top rear edge)

// display placeholder
DW = 160; DH = 40; DD = 12;             // width, height (up the slope), depth
CT = 2.5;               // carrier plate
TAB = 12;               // carrier end tabs (screws)
C = 0.4; WL = 2.5;      // clearance, visor wall
CW = DW + 2*TAB;        // carrier width
VN = CT + DD + 0.3;     // visor depth out of the face (display front flush with the rim)
VS = [FACE[0] - 1.5, FACE[1]];          // visor outer S range (bottom wall hangs 1.5 below the face edge)
PS0 = (VS[0] + VS[1]) / 2 - DH/2;       // display bottom S (centred in the visor)
SCREW_X = CW/2 - TAB/2;
SCREW_S = [PS0 + 8, PS0 + DH - 8];
CAB = [60, 16];         // cable slot (w, S length) through carrier and beam plate

r = 1 / sqrt(2);
O = [0, ZB - FC, ZB];
module frame() multmatrix([[1, 0, 0, O[0]], [0, r, -r, O[1]], [0, r, r, O[2]], [0, 0, 0, 1]]) children();

module middle() {
    difference() {
        union() {
            rotate([90, 0, 90]) translate([0, 0, -W]) linear_extrude(2 * W) polygon(PROFILE);
            frame() difference() {                                                                   // visor rim (walls only)
                translate([-CW/2 - C - WL, VS[0], -0.5]) cube([CW + 2*(C + WL), VS[1] - VS[0], VN + 0.5]);
                translate([-CW/2 - C, VS[0] + WL, -1]) cube([CW + 2*C, VS[1] - VS[0] - 2*WL, VN + 2]);
            }
        }
        frame() {
            translate([-CAB[0]/2, PS0 + (DH - CAB[1])/2, -20]) cube([CAB[0], CAB[1], 21]);              // cable slot
            for (sx = [-1, 1], s = SCREW_S) translate([sx * SCREW_X, s, -6]) cylinder(d = 4.0, h = 7, $fn = 24);  // M3 insert pilots
            translate([0, PS0 + 4, -0.6]) linear_extrude(0.7) text("CRN-D-BM", size = 4, halign = "center", valign = "center", font = "Liberation Sans:style=Bold");
        }
        translate([-W - 1, GY0, GZ0]) cube([2*W + 2, 3, GZ1 - GZ0]);                                  // roof seat groove
    }
}

module carrier() {
    difference() {
        translate([-CW/2, PS0, 0]) cube([CW, DH, CT]);
        translate([-CAB[0]/2, PS0 + (DH - CAB[1])/2, -1]) cube([CAB[0], CAB[1], CT + 2]);
        for (sx = [-1, 1], s = SCREW_S) translate([sx * SCREW_X, s, -1]) cylinder(d = 3.4, h = CT + 2, $fn = 24);
        translate([0, PS0 + DH - 4, CT - 0.5]) linear_extrude(1) text("CRN-D-CR", size = 3.5, halign = "center", valign = "center", font = "Liberation Sans:style=Bold");
    }
}

module ends() {
    intersection() {
        import(beam_stl, convexity = 10);
        union() for (s = [-1, 1]) translate([s > 0 ? END : -150, -40, -40]) cube([150 - END, 80, 80]);
    }
}

if (part == "beam") union() { ends(); middle(); }
if (part == "carrier") frame() carrier();
if (part == "panel") frame() for (sx = [-1, 1]) translate([sx > 0 ? 0.1 : -DW/2, PS0, CT]) cube([DW/2 - 0.1, DH, DD]);
if (part == "screws") frame() for (sx = [-1, 1], s = SCREW_S) translate([sx * SCREW_X, s, -5]) { cylinder(d = 3, h = 5 + CT, $fn = 16); translate([0, 0, 5 + CT]) cylinder(d = 5.7, h = 1.65, $fn = 24); }
