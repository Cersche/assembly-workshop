// CRN-E concept (Brian 2026-10-30): MAX7219 4-in-1 dot-matrix module (NOYITO, green, 32 x 8 dots) set into
// the sloped face of a reprinted Lab Rax top front beam. Beam: original ends (|x| >= END) kept exactly from
// the creator mesh; middle = the stock end-block section (x = 116) extruded, with a pocket sunk into the
// face, a slim rim and a cable slot through the plate. Carrier: a plate with end walls the module is fixed
// to (foam tape, or screws if the PCB has holes) and wired on the bench; it drops into the pocket and is held by 2 x M3 into heat-set inserts.
// Beam-local coordinates (-Y = rack front, Z up). Slope frame: X along the beam, S up the face, N out.
// CONCEPT ONLY: module numbers are nominal (FC-16 style 128 x 32 PCB); depth, header length, mounting
// holes UNKNOWN until Brian measures one. Fit, strength UNKNOWN. Not printed.

include <crn_c_profile.scad>   // PROFILE = stock section at x = 116 (generated by build_crn_c.py)

part = "beam";          // beam | carrier | module | screws
beam_stl = "beam_orig.stl";

FC = 21.85; ZB = -7.575; END = 111; W = 112;
GY0 = 6.58; GZ0 = 22.72; GZ1 = 26.22;   // roof seat groove

// module placeholder (UNKNOWN until measured)
ML = 128; MH = 32; MD = 12;             // PCB length, height (up the slope), total depth
HDR = 12;               // 5-pin header + plug past each end
CT = 2;                 // carrier floor
C = 0.4; WL = 2.5;      // clearance, rim / carrier wall
TABW = 10;              // carrier screw tab at each end
CL = ML + 2*HDR;        // carrier inner length
CW_ = CL + 2*WL + 2*TABW;               // carrier outer length incl. tabs
S0 = 10.4;              // module bottom edge, up the face: pocket floor stays 2.8 above U9
R = 6;                  // pocket depth: pocket top stays 3 mm below the roof rail
RIM = CT + MD - R;      // rim height = module front flush with the rim
SCREW_X = CW_/2 - TABW/2;
CAB = [24, 14];         // cable slot at the input end (w, S length)
CABX = -(ML/2 + HDR/2); // input header end (left, seen from the front)

r = 1 / sqrt(2);
O = [0, ZB - FC, ZB];
module frame() multmatrix([[1, 0, 0, O[0]], [0, r, -r, O[1]], [0, r, r, O[2]], [0, 0, 0, 1]]) children();

PX = CW_/2 + C;                         // pocket half length
PS = [S0 - C, S0 + MH + C];           // pocket S range (the pocket walls hold the module's long edges)

module middle() {
    difference() {
        union() {
            rotate([90, 0, 90]) translate([0, 0, -W]) linear_extrude(2 * W) polygon(PROFILE);
            frame() difference() {                                                         // slim rim
                translate([-PX - WL, PS[0] - WL, -0.5]) cube([2*(PX + WL), PS[1] - PS[0] + 2*WL, RIM + 0.5]);
                translate([-PX, PS[0], -1]) cube([2*PX, PS[1] - PS[0], RIM + 2]);
            }
        }
        frame() {
            translate([-PX, PS[0], -R]) cube([2*PX, PS[1] - PS[0], R + 0.01]);                   // pocket
            translate([CABX - CAB[0]/2, S0 + (MH - CAB[1])/2, -30]) cube([CAB[0], CAB[1], 31]);  // cable slot
            for (sx = [-1, 1]) translate([sx * SCREW_X, S0 + MH/2, -R - 6]) cylinder(d = 4.0, h = 7, $fn = 24);
            translate([0, S0 + MH/2, -R - 0.6]) linear_extrude(0.7) text("CRN-E-BM", size = 4, halign = "center", valign = "center", font = "Liberation Sans:style=Bold");
        }
        translate([-W - 1, GY0, GZ0]) cube([2*W + 2, 3, GZ1 - GZ0]);                          // roof seat groove
    }
}

module carrier() {      // in pocket coordinates: floor sits on the pocket floor (N = -R)
    translate([0, 0, -R]) difference() {
        union() {
            translate([-CW_/2, S0, 0]) cube([CW_, MH, CT]);                                  // floor + screw tabs
            for (sx = [-1, 1]) translate([sx > 0 ? CL/2 : -CL/2 - WL, S0, 0]) cube([WL, MH, CT + 6]);  // end walls
        }
        translate([CABX - CAB[0]/2, S0 + (MH - CAB[1])/2, -1]) cube([CAB[0], CAB[1], CT + 2]);
        translate([-ML/2 + 8, S0 + 6, -1]) cube([ML - 16, MH - 12, CT + 2]);                     // lighten / chip relief
        for (sx = [-1, 1]) translate([sx * SCREW_X, S0 + MH/2, -1]) cylinder(d = 3.4, h = CT + 2, $fn = 24);
        translate([CL/2 - 4, S0 + MH/2, -0.01]) rotate([0, 0, 90]) mirror([1, 0, 0]) linear_extrude(0.5) text("CRN-E-CR", size = 3, halign = "center", valign = "center", font = "Liberation Sans:style=Bold");
    }
}

module ends() {
    intersection() {
        import(beam_stl, convexity = 10);
        union() for (s = [-1, 1]) translate([s > 0 ? END : -150, -40, -40]) cube([150 - END, 80, 80]);
    }
}

if (part == "beam") union() { ends(); middle(); }
if (part == "carrier") frame() carrier();
if (part == "module") frame() translate([0, 0, -R + CT]) {
    translate([-ML/2, S0, 0]) cube([ML, MH, 1.6]);                                                  // PCB
    for (i = [0 : 3]) translate([-ML/2 + i * 32 + 0.3, S0 + 0.3, 1.6]) cube([31.4, 31.4, MD - 1.6]);  // 8x8 blocks
    for (sx = [-1, 1]) translate([sx > 0 ? ML/2 : -ML/2 - HDR + 2, S0 + MH/2 - 6.5, 0]) cube([HDR - 2, 13, 4]);  // headers/plugs
}
if (part == "screws") frame() for (sx = [-1, 1]) translate([sx * SCREW_X, S0 + MH/2, -R - 5]) { cylinder(d = 3, h = 5 + CT, $fn = 16); translate([0, 0, 5 + CT]) cylinder(d = 5.7, h = 1.65, $fn = 24); }
