+// @m6-rails-begin
+// Opt-in generated split rails; removed byte-for-byte from legacy sources.
+m6_rails=true; m6_rail_t=3.3; m6_joint_x=[-65.8,65.8]; m6_joint_z=[8.6,35.8];
