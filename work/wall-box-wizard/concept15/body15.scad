$fn=48;
// Shared constants; wall_box.py keeps the same numbers (test_wall_box checks they match).
boss_r=5; boss_inset=4; boss_len=10; insert_pilot=4.0; insert_depth=8.2; m3_clear=3.4;
lid_clear=0.3; lip_t=1.6; lip_h=6; snap_y=4; snap_r=0.6; groove_r=0.8;
hinge_r=5; hinge_gap=0.4; hinge_pin=2.0; hinge_segments=5;   // concept 15: r5 knuckles hold an M3 insert; pin/segments unused
latch_w=18; latch_arm=2; latch_reach=7;
key_head=9; key_slot=4.5; key_rise=9; key_from_top=20; key_from_side=15; key_max_x=60;
tab_w=20; tab_len=16; tab_t=4; tab_hole=4.5;
cleat_c=8; cleat_h=25; cleat_hole=4.5; spacer_h=12;
vent_w=2.5; vent_pitch=5.5; vent_inset=12;

wo=inner_w+2*wall; ho=inner_h+2*wall; di=inner_d; db=inner_d+wall;
ri=max(corner_r-wall,0.5);
WALLS=["lid","back","left","right","top","bottom"];
function widx(w)=search([w],WALLS)[0];
// [origin, u, y(inward), v]
function frame(w)=
 w=="lid"   ? [[wo/2,-wall,ho/2],[1,0,0],[0,1,0],[0,0,1]] :
 w=="back"  ? [[wo/2,db,ho/2],[-1,0,0],[0,-1,0],[0,0,1]] :
 w=="left"  ? [[0,di/2,ho/2],[0,-1,0],[1,0,0],[0,0,1]] :
 w=="right" ? [[wo,di/2,ho/2],[0,1,0],[-1,0,0],[0,0,1]] :
 w=="top"   ? [[wo/2,di/2,ho],[1,0,0],[0,0,-1],[0,1,0]] :
              [[wo/2,di/2,0],[-1,0,0],[0,0,1],[0,1,0]];
function half(w)=w=="lid"||w=="back"?[inner_w/2,inner_h/2]:w=="left"||w=="right"?[di/2,inner_h/2]:[inner_w/2,di/2];
module on_wall(w){f=frame(w);multmatrix([[f[1][0],f[2][0],f[3][0],f[0][0]],[f[1][1],f[2][1],f[3][1],f[0][1]],
 [f[1][2],f[2][2],f[3][2],f[0][2]],[0,0,0,1]])children();}

// Rounded box with the four edges parallel to Y rounded.
module rbox(x0,x1,y0,y1,z0,z1,r){
 if(r<=0)translate([x0,y0,z0])cube([x1-x0,y1-y0,z1-z0]);
 else hull()for(x=[x0+r,x1-r],z=[z0+r,z1-r])translate([x,y0,z])rotate([-90,0,0])cylinder(r=r,h=y1-y0);
}
module rrect(x0,x1,z0,z1,r){if(r<=0)translate([x0,z0])square([x1-x0,z1-z0]);
 else hull()for(x=[x0+r,x1-r],z=[z0+r,z1-r])translate([x,z])circle(r=r);}

// Golden keystone (the SG108 copy from equipment_tray.scad, unchanged numbers): a 21 x 33.5 mm block, 4 mm deep from
// the outer face, replaces the wall around each keystone; on walls thinner than 4 mm it stands inward as a pad.
module ks_gold_one(u,v){intersection(){
 translate([u,4,v])multmatrix([[1,0,0,0],[0,0,1,-4],[0,-1,0,25.09],[0,0,0,1]])intersection(){
  union()for(b=KS_GOLD)translate([b[0],0,0])rotate([90,0,90])linear_extrude(height=b[1])for(pg=b[2])
   translate([b[1]>10&&min([for(q=pg)q[0]])>30?-ks_tight:0,0])polygon([for(q=pg)[q[0],q[1]-0.08]]);
  translate([-10.5,25.09-18.6,-0.09])cube([21,33.7,10.42]);
 }
 translate([u-10.5,-1,v-15])cube([21,16,33.5]);
}}
module ks_box(u,v){translate([u-10.5,-0.01,v-15])cube([21,4.02,33.5]);}

module cutout_shape(c){k=c[1];u=c[2];v=c[3];
 if(k=="keystone")ks_box(u,v);
 else if(k=="gland"||k=="round")translate([u,-0.1,v])rotate([-90,0,0])cylinder(d=c[4],h=wall+0.2);
 else if(k=="rect")translate([u-c[4]/2,-0.1,v-c[5]/2])cube([c[4],wall+0.2,c[5]]);
 else if(k=="slot")translate([0,-0.1,0])rotate([-90,0,0])linear_extrude(wall+0.2)hull()   // c[4] long along u, c[5] wide
  for(s=[-1,1])translate([u+s*(c[4]-c[5])/2,-v])circle(d=c[5],$fn=40);
}

// Vent slots run along v, inside the wall's usable area less vent_inset, minus every keep-out.
module vent_cut(w){h=half(w);u0=-h[0]+vent_inset;u1=h[0]-vent_inset;v0=-h[1]+vent_inset;v1=h[1]-vent_inset;
 n=floor((u1-u0-vent_w)/vent_pitch)+1;
 if(u1-u0>vent_w&&v1-v0>vent_w)translate([0,-0.1,0])rotate([-90,0,0])linear_extrude(height=wall+0.2)mirror([0,1,0])
  difference(){
   intersection(){
    for(i=[0:n-1])let(x=(u0+u1)/2+(i-(n-1)/2)*vent_pitch)translate([x-vent_w/2,v0])square([vent_w,v1-v0]);
    translate([u0,v0])square([u1-u0,v1-v0]);
   }
   for(a=vent_avoid)if(a[0]==w)translate([a[1],a[2]])square([a[3]-a[1],a[4]-a[2]]);
  }
}

module keyhole_2d(){circle(d=key_head);translate([-key_slot/2,0])square([key_slot,key_rise]);translate([0,key_rise])circle(d=key_slot);}
function key_pos()=let(x=min(inner_w/2-key_from_side,key_max_x))[[-x,inner_h/2-key_from_top],[x,inner_h/2-key_from_top]];

module bosses(){if(lid_style=="screw")for(x=[wall+boss_inset,wo-wall-boss_inset],z=[wall+boss_inset,ho-wall-boss_inset])
 translate([x,0,z])rotate([-90,0,0])cylinder(r=boss_r,h=boss_len);}
module boss_pilots(){if(lid_style=="screw")for(x=[wall+boss_inset,wo-wall-boss_inset],z=[wall+boss_inset,ho-wall-boss_inset])
 translate([x,-0.1,z])rotate([-90,0,0])cylinder(d=insert_pilot,h=insert_depth+0.1);}

module standoff_add(){for(s=standoffs)translate([wo/2+s[0],di+0.01,ho/2+s[1]])rotate([90,0,0])cylinder(d=s[4],h=s[2]+0.01);}
module standoff_cut(){for(s=standoffs)translate([wo/2+s[0],di+0.02,ho/2+s[1]])rotate([90,0,0])cylinder(d=s[3],h=s[2]+0.1);}

hinge_x=-hinge_r-hinge_gap-1; hinge_y=-wall+4.1;   // axis 4.1 behind the lid face so the M3 counterbore stays inside the flat-cut knuckle
// Concept 15: knuckles stop short of the rounded corners and are cut flush with the lid face (y=-wall), so the lid
// prints face-down flat and nothing stands proud at the front. Body knuckle flank is ~45 deg printed back-down.
// No filament pin (Brian, 2026-10-27): two short hinge sets, bottom and top, each body-lid-body knuckles on an M3
// screw. The screw goes in from the box end (head in a counterbore in the outer body knuckle) and threads into an M3
// heat-set insert pressed into the inner body knuckle from its free end. The lid turns on the screw shank; undo two
// screws to take the lid off. Screw length ~M3 x 30 (thread/insert engagement, play and wear UNKNOWN).
hinge_kn=10; hinge_head_d=6.2; hinge_head_h=3.2;
function hinge_sets()=[corner_r, ho-corner_r-(3*hinge_kn+2*hinge_gap)];
module hinge_part(body){for(z0=hinge_sets())let(top=z0>ho/2)for(i=[0:2])if((i!=1)==body)
 translate([0,0,z0+i*(hinge_kn+hinge_gap)])difference(){
  linear_extrude(height=hinge_kn)intersection(){
   hull(){translate([hinge_x,hinge_y])circle(r=hinge_r);
    if(body)translate([-0.6,hinge_gap])square([wall+0.6,3*hinge_r+1]);   // long flank: ~40 deg printed back-down
    else translate([hinge_x-hinge_r,-wall])square([hinge_r-hinge_x,wall]);}   // lid: flat foot on the bed, no overhang
   translate([-30,-wall])square([60,40]);}
  outer=(i==0&&!top)||(i==2&&top);
  translate([hinge_x,hinge_y,-0.1])cylinder(d=body&&!outer?insert_pilot:m3_clear,h=hinge_kn+0.2);
  if(body&&outer)translate([hinge_x,hinge_y,top?hinge_kn-hinge_head_h:-0.1])cylinder(d=hinge_head_d,h=hinge_head_h+0.1);
 }}
// Louvre style (Brian, 2026-10-27): two bands of slots across the lid, top and bottom, each slot sloping up 45 deg
// from the outer face so the inside is hidden from eye level. Lid prints face-down: the sloped faces need no support.
// louv_rise: how far each slot climbs through the wall (wall+0.2 = 45 deg). 0 = straight through (Brian 2026-10-27:
// the angled slots looked good but were not practical to print).
louv_rise=0;
lid_louvres=true; louv_n=4; louv_h=3; louv_pitch=6; louv_side=22; louv_top=30; louv_bot=22;
// Body louvres (Brian, 2026-10-27: same look as the lid) replace the straight slots on the walls in `vents`.
// Sides: horizontal slots along the depth, sloping up 45 deg inward; top band level with the lid's, lower band at
// Z60-80 (clear of the keystone and power hole), Y20..di-12 (clear of the hinge knuckles). Printed back-down the
// sloped faces stand vertical. Top: slots across the width, sloping back 45 deg inward (45 deg ceiling printed).
louv_side_y0=20; louv_side_y1=di-12; louv_low=60;
module body_louvre_cut(){
 zs=concat([for(i=[0:louv_n-1])louv_low+i*louv_pitch],[for(i=[0:louv_n-1])ho-louv_top-i*louv_pitch]);
 for(s=["left","right"])if(search([s],vents)[0]!=[])for(z=zs)
  translate([s=="left"?0:wo,louv_side_y1,0])mirror([s=="left"?0:1,0,0])rotate([90,0,0])
   linear_extrude(height=louv_side_y1-louv_side_y0)
    polygon([[-0.1,z],[-0.1,z+louv_h],[wall+0.1,z+louv_h+louv_rise],[wall+0.1,z+louv_rise]]);
 if(search(["top"],vents)[0]!=[])let(n=floor((di-2*vent_inset-louv_h)/louv_pitch)+1,y0=di/2-((n-1)*louv_pitch+louv_h)/2)
  for(i=[0:n-1])let(y=y0+i*louv_pitch)translate([wall+vent_inset,0,0])rotate([90,0,90])
   linear_extrude(height=wo-2*wall-2*vent_inset)
    polygon([[y,ho+0.1],[y+louv_h,ho+0.1],[y+louv_h+louv_rise,ho-wall-0.1],[y+louv_rise,ho-wall-0.1]]);
}

module lid_louvre_cut(){if(lid_louvres)for(z=concat([for(i=[0:louv_n-1])louv_bot+i*louv_pitch],
  [for(i=[0:louv_n-1])ho-louv_top-i*louv_pitch]))
 translate([louv_side,0,0])rotate([90,0,90])linear_extrude(height=wo-2*louv_side)
  polygon([[-wall-0.1,z],[-wall-0.1,z+louv_h],[0.1,z+louv_h+louv_rise],[0.1,z+louv_rise]]);}
// Magnet catch (concept 15): a disc magnet in each right-hand corner of the body and a facing one in the lid,
// 0.3 mm apart when closed. Pockets open towards each other: press/glue magnets in, opposite poles facing.
// Body blocks print back-down: a 45 deg gusset into the corner carries them, no supports.
mag_c=6+wall; mag_gap=0.3; mag_lid_h=2;
function mag_pos()=[[wo-mag_c,mag_c],[wo-mag_c,ho-mag_c]];
module mag_body_add(){if(len(lid_magnets)==2)let(d=lid_magnets[0]+4,y0=mag_lid_h+mag_gap,y1=y0+lid_magnets[1]+1.2)
 intersection(){for(p=mag_pos())hull(){translate([p[0],y0,p[1]])rotate([-90,0,0])cylinder(d=d,h=y1-y0);
   translate([wo-wall-0.5,y1+1.4*d,p[1]<ho/2?wall+0.5:ho-wall-0.5])sphere(r=0.5);}
  rbox(0,wo,0,db,0,ho,corner_r);}}
module mag_body_cut(){if(len(lid_magnets)==2)for(p=mag_pos())translate([p[0],mag_lid_h+mag_gap-0.01,p[1]])rotate([-90,0,0])
