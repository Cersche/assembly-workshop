// Latch: a ramped ridge on the right wall; the lid's arm hooks behind it.
module latch_ridge(){translate([0,0,ho/2-latch_w/2+1])linear_extrude(height=latch_w-2)polygon([[wo-0.01,2],[wo+1,4],[wo+1,5],[wo-0.01,5]]);}
module latch_arm(){translate([0,0,ho/2-latch_w/2])linear_extrude(height=latch_w)union(){
 translate([wo-0.01,-wall])square([1.3+latch_arm+0.01,wall]);
 translate([wo+1.3,-wall])square([latch_arm,wall+latch_reach]);
 translate([wo+0.3,5.2])square([1.01,latch_reach-5.2]);
}}

module cleat_profile(){polygon([[db,ho],[db+cleat_c,ho],[db+cleat_c,ho-cleat_h],[db,ho-cleat_h+cleat_c]]);}
module mounts(){
 // Tabs: one above and one below the box on the back plane; screw hole tab_len/2 beyond the box.
 if(mount_style=="tabs")translate([0,db,0])rotate([90,0,0])linear_extrude(height=tab_t)for(top=[true,false])
  let(e=top?ho:0,s=top?1:-1)difference(){
   hull(){translate([wo/2-tab_w/2,e-(top?1:0)])square([tab_w,1]);translate([wo/2,e+s*tab_len/2])circle(d=tab_len);}
   translate([wo/2,e+s*tab_len/2])circle(d=tab_hole);
  }
 if(mount_style=="cleat"){
  translate([max(corner_r,0),0,0])rotate([90,0,90])linear_extrude(height=wo-2*max(corner_r,0))cleat_profile();
  translate([max(corner_r,0),db-0.01,max(corner_r,0)])cube([wo-2*max(corner_r,0),cleat_c+0.01,spacer_h]);
 }
}
module mount_cuts(){if(mount_style=="keyhole")for(p=key_pos())on_wall("back")translate([p[0],-0.1,p[1]])rotate([-90,0,0])
 linear_extrude(height=wall+0.2)mirror([0,1,0])keyhole_2d();}

// Porch ear-screw slots in the floor (Brian 2026-10-27: missing from the first printed sleeve). Same as c15.scad
// floor_cuts: 6 mm wide so the nut slider's key rides in it, key 10 + +-8 travel. The F hole stays the round cutout.
ear_slots=[[59,62],[46,14]]; ear_adj=8;
module ear_slots(){for(e=ear_slots)translate([e[0],e[1],-1])linear_extrude(wall+2)
 hull(){translate([-(ear_adj+5)+3,0])circle(d=6,$fn=24);translate([ear_adj+5-3,0])circle(d=6,$fn=24);}}

// Porch rev 2 fixings (Brian 2026-10-27): the porch gets its own two M3 screws from below into heat-set inserts in
// floor bosses, so it comes off without touching the splitter (whose ears keep their slots and nut sliders). Clear of
// the sliders' travel, the F hole and the X98 joint block; sleeve-only, the back plate is unchanged.
porch_screws=[[65,5],[86,62]]; porch_boss_d=9; porch_boss_h=8;
module porch_bosses(){for(p=porch_screws)translate([p[0],p[1],wall-0.01])cylinder(d=porch_boss_d,h=porch_boss_h-wall+0.01,$fn=32);}
module porch_pilots(){for(p=porch_screws)translate([p[0],p[1],-0.01])cylinder(d=insert_pilot,h=insert_depth,$fn=24);}

module body(){
 union(){
  difference(){
   union(){
    difference(){
     union(){rbox(0,wo,0,db,0,ho,corner_r);mounts();if(lid_style=="hinge"){hinge_part(true);if(len(lid_magnets)!=2)latch_ridge();}}
     rbox(wall,wo-wall,-1,di,wall,ho-wall,ri);
    }
    bosses();standoff_add();porch_bosses();if(lid_style=="hinge")mag_body_add();
   }
   boss_pilots();standoff_cut();mount_cuts();ear_slots();porch_pilots();if(lid_style=="hinge")mag_body_cut();
   if(lid_style=="snap")snap_grooves();
   for(c=cutouts)if(c[0]!="lid")on_wall(c[0])cutout_shape(c);
   if(lid_louvres)body_louvre_cut();else for(w=vents)if(w!="lid")on_wall(w)vent_cut(w);
  }
  for(c=cutouts)if(c[0]!="lid"&&c[1]=="keystone")on_wall(c[0])ks_gold_one(c[2],c[3]);
  body_labels();
 }
}

// Snap lid: a lip inside the opening with a bead on each side that clicks into a groove in the wall.
module lip_ring(){difference(){
 rbox(wall+lid_clear,wo-wall-lid_clear,-0.01,lip_h,wall+lid_clear,ho-wall-lid_clear,max(ri-lid_clear,0.5));
 rbox(wall+lid_clear+lip_t,wo-wall-lid_clear-lip_t,-1,lip_h+1,wall+lid_clear+lip_t,ho-wall-lid_clear-lip_t,max(ri-lid_clear-lip_t,0.5));
}}
module beads(r,extra){x0=wall+lid_clear;x1=wo-wall-lid_clear;z0=wall+lid_clear;z1=ho-wall-lid_clear;
 lx=(x1-x0)*0.6+extra;lz=(z1-z0)*0.6+extra;
 for(z=[z0,z1])translate([wo/2-lx/2,snap_y,z])rotate([0,90,0])cylinder(r=r,h=lx);
 for(x=[x0,x1])translate([x,snap_y,ho/2-lz/2])cylinder(r=r,h=lz);}
module snap_grooves(){beads(groove_r,2);}

module lid(){
 union(){
  difference(){
   union(){rbox(0,wo,-wall,0,0,ho,corner_r);
    if(lid_style=="snap"){lip_ring();intersection(){beads(snap_r,0);rbox(wall-0.5,wo-wall+0.5,0,lip_h,wall-0.5,ho-wall+0.5,ri);}}
    if(lid_style=="hinge"){hinge_part(false);if(len(lid_magnets)==2)mag_lid_add();else latch_arm();}
   }
   if(lid_style=="screw")for(x=[wall+boss_inset,wo-wall-boss_inset],z=[wall+boss_inset,ho-wall-boss_inset])
    translate([x,-wall-0.1,z])rotate([-90,0,0])cylinder(d=m3_clear,h=wall+0.2);
   if(lid_style=="hinge")mag_lid_cut();lid_louvre_cut();
   for(c=cutouts)if(c[0]=="lid")on_wall("lid")cutout_shape(c);
   for(w=vents)if(w=="lid")on_wall("lid")vent_cut("lid");
  }
  for(c=cutouts)if(c[0]=="lid"&&c[1]=="keystone")on_wall("lid")ks_gold_one(c[2],c[3]);
 }
}

// French-cleat wall rail (separate part): same thickness as the box cleat, its top slopes down towards the wall.
module cleat_rail(){L=wo-2*max(corner_r,0);n=max(2,floor(L/80)+1);
 difference(){
  rotate([90,0,90])linear_extrude(height=L)polygon([[0,0],[cleat_c,0],[cleat_c,cleat_h-cleat_c],[0,cleat_h]]);
  for(i=[0:n-1])let(x=10+i*(L-20)/(n-1))translate([x,-0.1,(cleat_h-cleat_c)/2])rotate([-90,0,0]){
   cylinder(d=cleat_hole,h=cleat_c+0.2);cylinder(d1=cleat_hole+4.4,d2=cleat_hole,h=2.2);}
 }}

// Port labels (Brian, 2026-10-27; lid art and maker's mark tried and dropped the same day): raised 0.6 where the walls
// print vertical. Font: Liberation Sans (ships with OpenSCAD).
art=true; art_font="Liberation Sans:style=Bold"; art_depth=0.6;
module wall_label(w,u,v,s,size=5)on_wall(w)translate([u,0.2,v])rotate([90,0,0])linear_extrude(art_depth+0.2)
 text(s,size=size,font=art_font,halign="center",valign="center");
module body_labels(){if(art){
 wall_label("right",22,18.5,"LAN");            // beside the Ethernet keystone
}}
// Two-piece body (Brian, 2026-10-27: "print it in pieces ... without it getting flimsy"; picked back plate + sleeve).
// part="back": flat back plate (keyholes, cradle bosses), prints outer face down. part="sleeve": the four walls with
// hinge knuckles, magnet blocks and louvres, prints back edge down (same as the one-piece body). Joint: six solid
// blocks in the sleeve's back corners and top/bottom (8 deep, sit on the bed when printing) take M3 heat-set inserts
// from the back; countersunk M3 x ~8 screws through the plate sit flush on the wall side. A 6 mm lip on the plate
// fits inside the sleeve (0.3 clearance) to keep it square and take racking. Bottom block at X22 clears the ear-screw
// slot and nut slider at the back of the floor. Screw/insert engagement and joint stiffness UNKNOWN until printed.
jt_blk=9; jt_d=8; jt_lip_h=6; jt_lip_t=2; jt_clear=0.3; jt_csk=6.4;
function jt_pts()=[[wall+4.5,wall+4.5],[wo-wall-4.5,wall+4.5],[wall+4.5,ho-wall-4.5],[wo-wall-4.5,ho-wall-4.5],
 [wo/2,ho-wall-4.5],[22,wall+4.5]];
module jt_blocks(grow=0){intersection(){
 for(p=jt_pts())translate([p[0]-jt_blk/2-1.5-grow,di-jt_d-grow,p[1]-jt_blk/2-1.5-grow])cube([jt_blk+3+2*grow,jt_d+2*grow,jt_blk+3+2*grow]);
 rbox(0,wo,-1,di-0.01,0,ho,corner_r);}}   // blocks sink 1.5 into the walls, end exactly at the back face
module jt_back_region(){translate([-50,di,-50])cube([wo+100,50,ho+100]);}
module jt_standoff_region(){for(s=standoffs)translate([wo/2+s[0],di+0.1,ho/2+s[1]])rotate([90,0,0])cylinder(d=s[4]+0.1,h=s[2]+0.2);}
module sleeve(){difference(){
 union(){intersection(){body();translate([-50,-50,-50])cube([wo+100,di+50-0.01,ho+100]);}jt_blocks();}   // 0.01 short of the plate face: avoids a coplanar cut
 jt_standoff_region();
 for(p=jt_pts())translate([p[0],di+0.01,p[1]])rotate([90,0,0])cylinder(d=insert_pilot,h=6);
}}
module back_plate(){difference(){
 union(){
  intersection(){body();union(){jt_back_region();jt_standoff_region();}}
  difference(){
   rbox(wall+jt_clear,wo-wall-jt_clear,di-jt_lip_h,di+0.01,wall+jt_clear,ho-wall-jt_clear,max(ri-jt_clear,0.5));
   rbox(wall+jt_clear+jt_lip_t,wo-wall-jt_clear-jt_lip_t,di-jt_lip_h-1,di+1,wall+jt_clear+jt_lip_t,ho-wall-jt_clear-jt_lip_t,max(ri-jt_clear-jt_lip_t,0.5));
   jt_blocks(0.4);
  }}
 for(p=jt_pts())translate([p[0],db+0.01,p[1]])rotate([90,0,0]){cylinder(d=m3_clear,h=wall+1);cylinder(d1=jt_csk,d2=m3_clear,h=(jt_csk-m3_clear)/2);}
}}
assert(wo<=250&&ho+(mount_style=="tabs"?2*tab_len:0)<=250&&db+wall+(mount_style=="cleat"?cleat_c:0)<=250,"Outer size above 250 mm");
if(part=="body")body();
else if(part=="lid")lid();
else if(part=="sleeve")sleeve();
else if(part=="back")back_plate();
else if(part=="cleat")cleat_rail();
else{body();translate([0,-wall-15,0])lid();if(mount_style=="cleat")translate([0,-wall-45-cleat_c,0])cleat_rail();}
