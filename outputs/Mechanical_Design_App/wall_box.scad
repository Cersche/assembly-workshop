// Wall-mount box (Brian, 2026-10-22; work/wall-box-wizard/Scope.md). PROPOSED - UNVALIDATED: fit, hinge/latch/snap
// function, wall-mount load and strength are UNKNOWN until printed and tested. Generated by wall_box.py, which
// replaces the parameter block and the keystone block below; edit the template, never a generated copy.
//
// Coordinates: body X 0..wo (width), Y 0..db (depth, front opening at Y=0, back against the wall), Z 0..ho (up).
// The lid covers the front opening at Y -wall..0. Every wall has its own frame: u to the right and v up as seen from
// outside (top/bottom: v towards the back), y into the box, origin at the centre of the wall's usable area.

// @@PARAMS@@
part="all";            // body, lid, cleat (French-cleat wall rail) or all
inner_w=120; inner_d=60; inner_h=90;
wall=2.5;              // a parameter, not a wall-thickness recommendation (generic guidance UNKNOWN)
corner_r=3;            // outer radius of the four front-to-back edges
lid_style="screw";     // screw, hinge, snap
mount_style="keyhole"; // keyhole, tabs, cleat
vents=[];              // wall names: left, right, top, bottom, back, lid
cutouts=[];            // [wall, kind, u, v, a, b]: keystone; gland/round (a = hole d); rect (a x b)
standoffs=[];          // [x, z, height, hole d, outer d], x/z from the box centre as seen from the front
vent_avoid=[];         // [wall, u0, v0, u1, v1] keep-outs from wall_box.py (cutouts, bosses, mounts, ...)
// @@END@@

// @@KEYSTONE@@
ks_tight=0.2;
KS_GOLD=[];
// @@END@@

$fn=48;
// Shared constants; wall_box.py keeps the same numbers (test_wall_box checks they match).
boss_r=5; boss_inset=4; boss_len=10; insert_pilot=4.0; insert_depth=8.2; m3_clear=3.4;
lid_clear=0.3; lip_t=1.6; lip_h=6; snap_y=4; snap_r=0.6; groove_r=0.8;
hinge_r=4; hinge_gap=0.4; hinge_pin=2.0; hinge_segments=5;
latch_w=18; latch_arm=2; latch_reach=7;
key_head=9; key_slot=4.5; key_rise=9; key_from_top=20; key_from_side=15; key_max_x=60;
tab_w=20; tab_len=16; tab_t=4; tab_hole=4.5;
cleat_c=8; cleat_h=25; cleat_hole=4.5; spacer_h=12;
vent_w=2.5; vent_pitch=5.5; vent_inset=12;

wo=inner_w+2*wall; ho=inner_h+2*wall; di=inner_d; db=inner_d+wall;
ri=max(corner_r-wall,0.5);
WALLS=["lid","back","left","right","top","bottom"];
function widx(w)=search([w],WALLS)[0];
// [origin, u, y(inward), v]
function frame(w)=
 w=="lid"   ? [[wo/2,-wall,ho/2],[1,0,0],[0,1,0],[0,0,1]] :
 w=="back"  ? [[wo/2,db,ho/2],[-1,0,0],[0,-1,0],[0,0,1]] :
 w=="left"  ? [[0,di/2,ho/2],[0,-1,0],[1,0,0],[0,0,1]] :
 w=="right" ? [[wo,di/2,ho/2],[0,1,0],[-1,0,0],[0,0,1]] :
 w=="top"   ? [[wo/2,di/2,ho],[1,0,0],[0,0,-1],[0,1,0]] :
              [[wo/2,di/2,0],[-1,0,0],[0,0,1],[0,1,0]];
function half(w)=w=="lid"||w=="back"?[inner_w/2,inner_h/2]:w=="left"||w=="right"?[di/2,inner_h/2]:[inner_w/2,di/2];
module on_wall(w){f=frame(w);multmatrix([[f[1][0],f[2][0],f[3][0],f[0][0]],[f[1][1],f[2][1],f[3][1],f[0][1]],
 [f[1][2],f[2][2],f[3][2],f[0][2]],[0,0,0,1]])children();}

// Rounded box with the four edges parallel to Y rounded.
module rbox(x0,x1,y0,y1,z0,z1,r){
 if(r<=0)translate([x0,y0,z0])cube([x1-x0,y1-y0,z1-z0]);
 else hull()for(x=[x0+r,x1-r],z=[z0+r,z1-r])translate([x,y0,z])rotate([-90,0,0])cylinder(r=r,h=y1-y0);
}
module rrect(x0,x1,z0,z1,r){if(r<=0)translate([x0,z0])square([x1-x0,z1-z0]);
 else hull()for(x=[x0+r,x1-r],z=[z0+r,z1-r])translate([x,z])circle(r=r);}

// Golden keystone (the SG108 copy from equipment_tray.scad, unchanged numbers): a 21 x 33.5 mm block, 4 mm deep from
// the outer face, replaces the wall around each keystone; on walls thinner than 4 mm it stands inward as a pad.
module ks_gold_one(u,v){intersection(){
 translate([u,4,v])multmatrix([[1,0,0,0],[0,0,1,-4],[0,-1,0,25.09],[0,0,0,1]])intersection(){
  union()for(b=KS_GOLD)translate([b[0],0,0])rotate([90,0,90])linear_extrude(height=b[1])for(pg=b[2])
   translate([b[1]>10&&min([for(q=pg)q[0]])>30?-ks_tight:0,0])polygon([for(q=pg)[q[0],q[1]-0.08]]);
  translate([-10.5,25.09-18.6,-0.09])cube([21,33.7,10.42]);
 }
 translate([u-10.5,-1,v-15])cube([21,16,33.5]);
}}
module ks_box(u,v){translate([u-10.5,-0.01,v-15])cube([21,4.02,33.5]);}

module cutout_shape(c){k=c[1];u=c[2];v=c[3];
 if(k=="keystone")ks_box(u,v);
 else if(k=="gland"||k=="round")translate([u,-0.1,v])rotate([-90,0,0])cylinder(d=c[4],h=wall+0.2);
 else if(k=="rect")translate([u-c[4]/2,-0.1,v-c[5]/2])cube([c[4],wall+0.2,c[5]]);
}

// Vent slots run along v, inside the wall's usable area less vent_inset, minus every keep-out.
module vent_cut(w){h=half(w);u0=-h[0]+vent_inset;u1=h[0]-vent_inset;v0=-h[1]+vent_inset;v1=h[1]-vent_inset;
 n=floor((u1-u0-vent_w)/vent_pitch)+1;
 if(u1-u0>vent_w&&v1-v0>vent_w)translate([0,-0.1,0])rotate([-90,0,0])linear_extrude(height=wall+0.2)mirror([0,1,0])
  difference(){
   intersection(){
    for(i=[0:n-1])let(x=(u0+u1)/2+(i-(n-1)/2)*vent_pitch)translate([x-vent_w/2,v0])square([vent_w,v1-v0]);
    translate([u0,v0])square([u1-u0,v1-v0]);
   }
   for(a=vent_avoid)if(a[0]==w)translate([a[1],a[2]])square([a[3]-a[1],a[4]-a[2]]);
  }
}

module keyhole_2d(){circle(d=key_head);translate([-key_slot/2,0])square([key_slot,key_rise]);translate([0,key_rise])circle(d=key_slot);}
function key_pos()=let(x=min(inner_w/2-key_from_side,key_max_x))[[-x,inner_h/2-key_from_top],[x,inner_h/2-key_from_top]];

module bosses(){if(lid_style=="screw")for(x=[wall+boss_inset,wo-wall-boss_inset],z=[wall+boss_inset,ho-wall-boss_inset])
 translate([x,0,z])rotate([-90,0,0])cylinder(r=boss_r,h=boss_len);}
module boss_pilots(){if(lid_style=="screw")for(x=[wall+boss_inset,wo-wall-boss_inset],z=[wall+boss_inset,ho-wall-boss_inset])
 translate([x,-0.1,z])rotate([-90,0,0])cylinder(d=insert_pilot,h=insert_depth+0.1);}

module standoff_add(){for(s=standoffs)translate([wo/2+s[0],di+0.01,ho/2+s[1]])rotate([90,0,0])cylinder(d=s[4],h=s[2]+0.01);}
module standoff_cut(){for(s=standoffs)translate([wo/2+s[0],di+0.02,ho/2+s[1]])rotate([90,0,0])cylinder(d=s[3],h=s[2]+0.1);}

hinge_x=-hinge_r-hinge_gap; hinge_y=-wall/2;
function seg_len()=(ho-(hinge_segments-1)*hinge_gap)/hinge_segments;
module hinge_part(body){L=seg_len();for(i=[0:hinge_segments-1])if((i%2==0)==body)translate([0,0,i*(L+hinge_gap)])
 difference(){
  linear_extrude(height=L)hull(){translate([hinge_x,hinge_y])circle(r=hinge_r);
   if(body)translate([-0.6,hinge_gap])square([wall+0.6,2*hinge_r]);else translate([0,-wall])square([2*hinge_r,wall]);}
  translate([hinge_x,hinge_y,-0.1])cylinder(d=hinge_pin,h=L+0.2);
 }}
// Latch: a ramped ridge on the right wall; the lid's arm hooks behind it.
module latch_ridge(){translate([0,0,ho/2-latch_w/2+1])linear_extrude(height=latch_w-2)polygon([[wo-0.01,2],[wo+1,4],[wo+1,5],[wo-0.01,5]]);}
module latch_arm(){translate([0,0,ho/2-latch_w/2])linear_extrude(height=latch_w)union(){
 translate([wo-0.01,-wall])square([1.3+latch_arm+0.01,wall]);
 translate([wo+1.3,-wall])square([latch_arm,wall+latch_reach]);
 translate([wo+0.3,5.2])square([1.01,latch_reach-5.2]);
}}

module cleat_profile(){polygon([[db,ho],[db+cleat_c,ho],[db+cleat_c,ho-cleat_h],[db,ho-cleat_h+cleat_c]]);}
module mounts(){
 // Tabs: one above and one below the box on the back plane; screw hole tab_len/2 beyond the box.
 if(mount_style=="tabs")translate([0,db,0])rotate([90,0,0])linear_extrude(height=tab_t)for(top=[true,false])
  let(e=top?ho:0,s=top?1:-1)difference(){
   hull(){translate([wo/2-tab_w/2,e-(top?1:0)])square([tab_w,1]);translate([wo/2,e+s*tab_len/2])circle(d=tab_len);}
   translate([wo/2,e+s*tab_len/2])circle(d=tab_hole);
  }
 if(mount_style=="cleat"){
  translate([max(corner_r,0),0,0])rotate([90,0,90])linear_extrude(height=wo-2*max(corner_r,0))cleat_profile();
  translate([max(corner_r,0),db-0.01,max(corner_r,0)])cube([wo-2*max(corner_r,0),cleat_c+0.01,spacer_h]);
 }
}
module mount_cuts(){if(mount_style=="keyhole")for(p=key_pos())on_wall("back")translate([p[0],-0.1,p[1]])rotate([-90,0,0])
 linear_extrude(height=wall+0.2)mirror([0,1,0])keyhole_2d();}

module body(){
 union(){
  difference(){
   union(){
    difference(){
     union(){rbox(0,wo,0,db,0,ho,corner_r);mounts();if(lid_style=="hinge"){hinge_part(true);latch_ridge();}}
     rbox(wall,wo-wall,-1,di,wall,ho-wall,ri);
    }
    bosses();standoff_add();
   }
   boss_pilots();standoff_cut();mount_cuts();
   if(lid_style=="snap")snap_grooves();
   for(c=cutouts)if(c[0]!="lid")on_wall(c[0])cutout_shape(c);
   for(w=vents)if(w!="lid")on_wall(w)vent_cut(w);
  }
  for(c=cutouts)if(c[0]!="lid"&&c[1]=="keystone")on_wall(c[0])ks_gold_one(c[2],c[3]);
 }
}

// Snap lid: a lip inside the opening with a bead on each side that clicks into a groove in the wall.
module lip_ring(){difference(){
 rbox(wall+lid_clear,wo-wall-lid_clear,-0.01,lip_h,wall+lid_clear,ho-wall-lid_clear,max(ri-lid_clear,0.5));
 rbox(wall+lid_clear+lip_t,wo-wall-lid_clear-lip_t,-1,lip_h+1,wall+lid_clear+lip_t,ho-wall-lid_clear-lip_t,max(ri-lid_clear-lip_t,0.5));
}}
module beads(r,extra){x0=wall+lid_clear;x1=wo-wall-lid_clear;z0=wall+lid_clear;z1=ho-wall-lid_clear;
 lx=(x1-x0)*0.6+extra;lz=(z1-z0)*0.6+extra;
 for(z=[z0,z1])translate([wo/2-lx/2,snap_y,z])rotate([0,90,0])cylinder(r=r,h=lx);
 for(x=[x0,x1])translate([x,snap_y,ho/2-lz/2])cylinder(r=r,h=lz);}
module snap_grooves(){beads(groove_r,2);}

module lid(){
 union(){
  difference(){
   union(){rbox(0,wo,-wall,0,0,ho,corner_r);
    if(lid_style=="snap"){lip_ring();intersection(){beads(snap_r,0);rbox(wall-0.5,wo-wall+0.5,0,lip_h,wall-0.5,ho-wall+0.5,ri);}}
    if(lid_style=="hinge"){hinge_part(false);latch_arm();}
   }
   if(lid_style=="screw")for(x=[wall+boss_inset,wo-wall-boss_inset],z=[wall+boss_inset,ho-wall-boss_inset])
    translate([x,-wall-0.1,z])rotate([-90,0,0])cylinder(d=m3_clear,h=wall+0.2);
   for(c=cutouts)if(c[0]=="lid")on_wall("lid")cutout_shape(c);
   for(w=vents)if(w=="lid")on_wall("lid")vent_cut("lid");
  }
  for(c=cutouts)if(c[0]=="lid"&&c[1]=="keystone")on_wall("lid")ks_gold_one(c[2],c[3]);
 }
}

// French-cleat wall rail (separate part): same thickness as the box cleat, its top slopes down towards the wall.
module cleat_rail(){L=wo-2*max(corner_r,0);n=max(2,floor(L/80)+1);
 difference(){
  rotate([90,0,90])linear_extrude(height=L)polygon([[0,0],[cleat_c,0],[cleat_c,cleat_h-cleat_c],[0,cleat_h]]);
  for(i=[0:n-1])let(x=10+i*(L-20)/(n-1))translate([x,-0.1,(cleat_h-cleat_c)/2])rotate([-90,0,0]){
   cylinder(d=cleat_hole,h=cleat_c+0.2);cylinder(d1=cleat_hole+4.4,d2=cleat_hole,h=2.2);}
 }}

assert(wo<=250&&ho+(mount_style=="tabs"?2*tab_len:0)<=250&&db+wall+(mount_style=="cleat"?cleat_c:0)<=250,"Outer size above 250 mm");
if(part=="body")body();
else if(part=="lid")lid();
else if(part=="cleat")cleat_rail();
else{body();translate([0,-wall-15,0])lid();if(mount_style=="cleat")translate([0,-wall-45-cleat_c,0])cleat_rail();}
