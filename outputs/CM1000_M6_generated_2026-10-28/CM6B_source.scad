module faceplate(){
 union(){
  difference(){
   union(){
    plate_layer(-plate_t,plate_t);
    if(ks_style=="v2")ks_collar();
    mr_stubs();
   }
   mr_pilots();
   if(sleeve&&joint=="screw")for(x=sl_joints,z=sl_joint_z)translate([x,-plate_t-0.1,z])rotate([-90,0,0])cylinder(d=m3_clear,h=plate_t+0.2);
